# Copy to .env (git-ignored) and fill in.
# Register for a free appID at https://www.e-stat.go.jp/api/ (マイページ → API機能(アプリケーションID発行)).
ESTAT_APP_ID=

# Free MoSPI API account from https://api.mospi.gov.in (POST /api/users/usersignup, or the
# Swagger page). Used only by `python -m src.fetch.mospi` to obtain a 15-minute token.
MOSPI_EMAIL=
MOSPI_PASSWORD=
