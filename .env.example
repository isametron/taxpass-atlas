# Copy to .env (git-ignored) and fill in.
# Register for a free appID at https://www.e-stat.go.jp/api/ (マイページ → API機能(アプリケーションID発行)).
ESTAT_APP_ID=

# Free MoSPI API account. Fill these in, then run `python -m src.fetch.mospi --signup` once.
# Your email doubles as the MoSPI username. Organization and purpose: letters, digits and spaces only.
# Keep the single quotes around the password.
MOSPI_EMAIL=
MOSPI_PASSWORD=''
MOSPI_GENDER=
MOSPI_ORGANIZATION=BMS College of Engineering
MOSPI_PURPOSE=Academic research
# If signup reports another blank field (e.g. 'Mobile cannot be blank'), add it as
# MOSPI_FIELD_<name>=value, e.g. MOSPI_FIELD_MOBILE=...
